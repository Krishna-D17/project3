+    ALGORITHM_NAME as DHASH_ALGORITHM_NAME,
+    ALGORITHM_VERSION as DHASH_ALGORITHM_VERSION,
+    STATUS_DECODE_FAILURE,
+    STATUS_INVALID_MEDIA,
+    STATUS_SUCCESS as DHASH_STATUS_SUCCESS,
+    TemporalDHashResult,
