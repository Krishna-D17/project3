+    assert prod_db.exists(), f"Production database not found at: {prod_db}"
+    initial_hash = hashlib.sha256(prod_db.read_bytes()).hexdigest()
+
+    # Run pytest --collect-only in a standalone clean subprocess
+    cmd = [
