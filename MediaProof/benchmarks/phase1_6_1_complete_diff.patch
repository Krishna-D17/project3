+
+    post_collect_hash = hashlib.sha256(prod_db.read_bytes()).hexdigest()
+    assert initial_hash == post_collect_hash, (
+        f"CRITICAL: Production database modified during pytest collection! "
+        f"Initial: {initial_hash}, Post-collection: {post_collect_hash}"
+    )

