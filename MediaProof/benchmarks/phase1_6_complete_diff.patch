+def test_scenario_3_prefix_or_suffix_trimming(temp_workspace: Path):
+    """
+    Scenario 3: Prefix or suffix trimming.
+    Temporal alignment matches the overlapping frames and identifies truncated samples.
+    Metadata comparison detects duration difference.
+    """
+    orig_path = temp_workspace / "orig_trim.mp4"
+    create_dynamic_test_video(orig_path, duration_seconds=4.0, fps=10.0)
+
+    ffmpeg_exe = get_ffmpeg_path()
+    if not ffmpeg_exe or not ffmpeg_exe.exists():
+        pytest.skip("FFmpeg not available for trimming test")
+
+    # Trim first 1.5 seconds (prefix trim: from 1.5s to 4.0s = 2.5s duration)
+    trimmed_path = temp_workspace / "prefix_trimmed.mp4"
+    cmd = [
+        str(ffmpeg_exe), "-y",
+        "-ss", "1.5",
+        "-i", str(orig_path),
+        "-c:v", "libx264",
+        "-preset", "ultrafast",
+        str(trimmed_path),
+    ]
+    run_ffmpeg_command(cmd)
+    assert trimmed_path.exists()
+
+    dhash_orig = extract_temporal_dhash(orig_path, sampling_interval_seconds=0.5)
+    dhash_trim = extract_temporal_dhash(trimmed_path, sampling_interval_seconds=0.5)
+
+    # Comparing orig as reference and trimmed as candidate
+    comp_dhash = compare_temporal_dhash_sequences(dhash_orig, dhash_trim)
+    assert comp_dhash.available is True
+    assert comp_dhash.candidate_sample_count < comp_dhash.reference_sample_count
+
+    meta_orig = extract_technical_metadata(orig_path)
+    meta_trim = extract_technical_metadata(trimmed_path)
+    comp_meta = compare_technical_metadata(meta_orig, meta_trim)
+
+    assert comp_meta.available is True
+    dur_diff = next(d for d in comp_meta.differences if d.field_path == "container.duration_seconds")
+    assert dur_diff.difference_type == DIFF_CHANGED
+    assert dur_diff.is_drift is True
+    assert comp_meta.summary.has_critical_drift is True  # Trimming > 1.0s flags critical duration drift
+
