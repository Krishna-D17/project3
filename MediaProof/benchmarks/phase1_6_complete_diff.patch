+def test_scenario_7_missing_or_jointly_unavailable_metadata_fields(temp_workspace: Path):
+    """
+    Scenario 7: Missing or jointly unavailable metadata fields.
+    Missing optional fields do NOT set is_drift=True, yielding STATUS_SUCCESS_WITH_MISSING_FIELDS.
+    """
+    video_path = temp_workspace / "meta_test.mp4"
+    create_dynamic_test_video(video_path, duration_seconds=2.0, fps=10.0)
+
+    meta_ref = extract_technical_metadata(video_path)
+    meta_cand = copy.deepcopy(meta_ref)
+
+    # Set optional profile/level to None in candidate, and make tags jointly empty
+    meta_cand.video_streams[0].profile = None
+    meta_cand.video_streams[0].level = None
+    meta_ref.container.tags = {}
+    meta_cand.container.tags = {}
+    meta_ref.video_streams[0].raw_tags = {}
+    meta_cand.video_streams[0].raw_tags = {}
+
+    comp_meta = compare_technical_metadata(meta_ref, meta_cand)
+    assert comp_meta.available is True
+    assert comp_meta.status == STATUS_SUCCESS_WITH_MISSING_FIELDS
+    assert comp_meta.summary.changed_fields_count == 0
+    assert comp_meta.summary.has_transcoding_drift is False
+    assert comp_meta.summary.has_critical_drift is False
+
+    # Verify partition invariant
+    s = comp_meta.summary
+    assert s.total_compared_fields == (
+        s.unchanged_fields_count
+        + s.changed_fields_count
+        + s.missing_fields_count
+        + s.uncomparable_fields_count
+    )
