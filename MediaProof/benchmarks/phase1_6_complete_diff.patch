+def test_scenario_2_benign_reencode_or_transcode(temp_workspace: Path):
+    """
+    Scenario 2: Benign re-encode or transcode.
+    Visual content is retained (perceptual match_ratio high, mean hamming small),
+    while metadata comparison identifies transcoding drift (e.g. bitrate, encoder).
+    """
+    orig_path = temp_workspace / "orig.mp4"
+    create_dynamic_test_video(orig_path, duration_seconds=2.0, fps=10.0, width=160, height=120)
+
+    ffmpeg_exe = get_ffmpeg_path()
+    if not ffmpeg_exe or not ffmpeg_exe.exists():
+        pytest.skip("FFmpeg not available for transcoding test")
+
+    # Transcode with a different CRF / lower bitrate
+    trans_path = temp_workspace / "transcoded.mp4"
+    cmd = [
+        str(ffmpeg_exe), "-y",
+        "-i", str(orig_path),
+        "-c:v", "libx264",
+        "-crf", "35",
+        "-preset", "faster",
+        str(trans_path),
+    ]
+    res = run_ffmpeg_command(cmd)
+    assert res.returncode == 0 and trans_path.exists()
+
+    dhash_orig = extract_temporal_dhash(orig_path, sampling_interval_seconds=0.5)
+    dhash_trans = extract_temporal_dhash(trans_path, sampling_interval_seconds=0.5)
+
+    comp_dhash = compare_temporal_dhash_sequences(dhash_orig, dhash_trans)
+    assert comp_dhash.available is True
+    # Perceptually, identical visual content withstands mild compression
+    assert comp_dhash.match_ratio >= 0.85
+    assert comp_dhash.mean_hamming_distance is not None
+    assert comp_dhash.mean_hamming_distance <= 8.0
+
+    meta_orig = extract_technical_metadata(orig_path)
+    meta_trans = extract_technical_metadata(trans_path)
+    comp_meta = compare_technical_metadata(meta_orig, meta_trans)
+
+    assert comp_meta.available is True
+    assert comp_meta.status == STATUS_SUCCESS_WITH_DRIFT
+    assert comp_meta.summary.has_transcoding_drift is True
