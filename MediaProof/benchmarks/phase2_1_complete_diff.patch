+def test_unicode_nfc_normalization():
+    """
+    Unicode NFC normalization must ensure that composed and decomposed forms
+    produce identical canonical bytes and hashes.
+    """
+    # Decomposed: 'e' + combining acute accent (\u0065\u0301)
+    # Composed: precomposed 'é' (\u00e9)
+    decomposed_str = "caf\u0065\u0301"
+    composed_str = "caf\u00e9"
+    assert decomposed_str != composed_str
+
+    event_decomposed = {
+        "schema_version": "1.0",
+        "event_id": f"EVT-{decomposed_str}",
+        "event_type": "ASSET_REGISTRATION",
+        "timestamp_utc": "2026-10-19T10:00:00Z",
+        "asset_id": f"MP-{decomposed_str}",
+        "payload": {decomposed_str: decomposed_str},
+    }
+
+    event_composed = {
+        "schema_version": "1.0",
+        "event_id": f"EVT-{composed_str}",
+        "event_type": "ASSET_REGISTRATION",
+        "timestamp_utc": "2026-10-19T10:00:00Z",
+        "asset_id": f"MP-{composed_str}",
+        "payload": {composed_str: composed_str},
+    }
+
+    bytes_decomp = canonical_serialize_event(event_decomposed)
+    bytes_comp = canonical_serialize_event(event_composed)
+
+    assert bytes_decomp == bytes_comp
+    assert calculate_event_hash(event_decomposed) == calculate_event_hash(event_composed)
+
