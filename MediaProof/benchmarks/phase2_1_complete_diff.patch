+def test_timestamp_normalization_variants():
+    """
+    Different representations of the same UTC timestamp must normalize to
+    the exact same canonical string and bytes.
+    """
+    ts_z = "2026-10-19T15:30:45Z"
+    ts_offset = "2026-10-19T15:30:45+00:00"
+    dt_obj = datetime(2026, 10, 19, 15, 30, 45, tzinfo=timezone.utc)
+
+    norm_z = normalize_timestamp_utc(ts_z)
+    norm_offset = normalize_timestamp_utc(ts_offset)
+    norm_dt = normalize_timestamp_utc(dt_obj)
+
+    assert norm_z == "2026-10-19T15:30:45Z"
+    assert norm_offset == norm_z
+    assert norm_dt == norm_z
+
