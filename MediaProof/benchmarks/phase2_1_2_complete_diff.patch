+def test_numeric_encoder_exact_byte_representations():
+    """
+    Asserts fixed expected serialized bytes for IEEE 754 float boundaries,
+    exponent formatting, large integers (>64-bit), and boolean distinction.
+    """
+    base = {
+        "schema_version": "1.0",
+        "event_id": "EVT-NUM-GATE",
+        "event_type": "ASSET_REGISTRATION",
+        "timestamp_utc": "2026-10-19T10:00:00Z",
+        "asset_id": "MP-NUM-GATE",
+    }
+
+    # 1. Exponent notation floats
+    ev_exp = {
+        **base,
+        "payload": {
+            "f_neg_6": 1e-6,
+            "f_neg_7": 1e-7,
+            "f_pos_20": 1e20,
+            "f_pos_21": 1e21,
+        },
+    }
+    b_exp = canonical_serialize_event(ev_exp)
+    assert b'"f_neg_6":1e-06' in b_exp
+    assert b'"f_neg_7":1e-07' in b_exp
+    assert b'"f_pos_20":1e+20' in b_exp
+    assert b'"f_pos_21":1e+21' in b_exp
+
+    # 2. Signed zero floats (-0.0 normalized to 0.0)
+    ev_zero_neg = {**base, "payload": {"val": -0.0}}
+    ev_zero_pos = {**base, "payload": {"val": 0.0}}
+    b_zero_neg = canonical_serialize_event(ev_zero_neg)
+    b_zero_pos = canonical_serialize_event(ev_zero_pos)
+    assert b_zero_neg == b_zero_pos
+    assert b'"val":0.0' in b_zero_neg
+    assert b"-0.0" not in b_zero_neg
+
+    # 3. Subnormal and extreme finite floats
+    ev_subnormal = {**base, "payload": {"subnormal": 5e-324, "max_finite": 1.7976931348623157e+308}}
+    b_sub = canonical_serialize_event(ev_subnormal)
+    assert b'"subnormal":5e-324' in b_sub
+    assert b'"max_finite":1.7976931348623157e+308' in b_sub
+
+    # 4. Integers larger than 64 bits
+    ev_large_int = {
+        **base,
+        "payload": {
+            "int_64": 18446744073709551616,  # 2^64
+            "int_128": 340282366920938463463374607431768211456,  # 2^128
+            "int_10_30": 10**30,
+        },
+    }
+    b_large_int = canonical_serialize_event(ev_large_int)
+    assert b'"int_64":18446744073709551616' in b_large_int
+    assert b'"int_128":340282366920938463463374607431768211456' in b_large_int
+    assert b'"int_10_30":1000000000000000000000000000000' in b_large_int
+
+    # 5. Booleans vs integers
+    ev_bool_int = {
+        **base,
+        "payload": {
+            "b_true": True,
+            "b_false": False,
+            "i_one": 1,
+            "i_zero": 0,
+        },
+    }
+    b_bool_int = canonical_serialize_event(ev_bool_int)
+    assert b'"b_false":false,"b_true":true,"i_one":1,"i_zero":0' in b_bool_int
+
+    # 6. Non-finite floats rejected
+    for non_finite in [float("nan"), float("inf"), float("-inf")]:
+        with pytest.raises(EventValidationError, match="Non-finite float value"):
+            canonical_serialize_event({**base, "payload": {"val": non_finite}})
+
