+def test_canonical_serialization_does_not_mutate_production_database():
+    """
+    Verifies that running serialization, validation, and hashing operations
+    never accesses, initializes, or modifies the production database.
+    """
+    prod_db = Path(__file__).resolve().parent.parent / "database" / "mediaproof.db"
+    assert prod_db.exists(), f"Production database not found at {prod_db}"
+    initial_hash = hashlib.sha256(prod_db.read_bytes()).hexdigest()
+
+    # Perform extensive serialization operations
+    for i in range(100):
+        evt = ProvenanceEvent(
+            event_id=f"EVT-PROD-TEST-{i}",
+            event_type="ASSET_REGISTRATION",
+            timestamp_utc="2026-10-19T12:00:00Z",
+            asset_id=f"MP-{i:04d}",
+            payload={"iteration": i, "data": "test"},
+            sequence_number=i,
+        )
+        b = evt.to_canonical_bytes()
+        h = evt.calculate_hash()
+        assert len(b) > 0
+        assert len(h) == 64
+
+    post_hash = hashlib.sha256(prod_db.read_bytes()).hexdigest()
+    assert initial_hash == post_hash, "Production database modified by event serialization!"
