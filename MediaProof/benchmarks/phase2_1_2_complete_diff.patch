+def test_invalid_and_ambiguous_timestamps_fail_explicitly():
+    """
+    Invalid dates, ambiguous strings, or non-timezone-aware inputs must
+    fail explicitly with EventValidationError.
+    """
+    base = {
+        "schema_version": "1.0",
+        "event_id": "EVT-TIME-FAIL",
+        "event_type": "ASSET_REGISTRATION",
+        "asset_id": "MP-TIME-FAIL",
+        "payload": {},
+    }
+
+    invalid_timestamps = [
+        "2026-10-19T10:00:00",       # Naive string (no timezone)
+        "2026-02-30T10:00:00Z",      # Invalid calendar date
+        "2026-13-01T10:00:00Z",      # Invalid month
+        "2026-10-19 10:00:00Z",      # Missing 'T' separator
+        "yesterday",                 # Not ISO
+        "",                          # Empty
+        "   ",                       # Whitespace
+        1700000000,                  # Unix epoch integer (disallowed)
+        None,                        # None (disallowed for required field)
+    ]
+
+    for bad_ts in invalid_timestamps:
+        with pytest.raises(EventValidationError):
+            validate_event({**base, "timestamp_utc": bad_ts})
