+    # All of these represent 2026-10-19 10:00:00 UTC
+    ts_variants = [
+        "2026-10-19T10:00:00Z",
+        "2026-10-19T10:00:00+00:00",
+        "2026-10-19T12:00:00+02:00",
+        "2026-10-19T15:30:00+05:30",
+        "2026-10-19T06:00:00-04:00",
+        datetime(2026, 10, 19, 10, 0, 0, tzinfo=timezone.utc),
+    ]
+
+    canonical_bytes_set = set()
+    hash_set = set()
+
+    for ts in ts_variants:
+        ev = {**base, "timestamp_utc": ts}
+        b = canonical_serialize_event(ev)
+        h = calculate_event_hash(ev)
+        canonical_bytes_set.add(b)
+        hash_set.add(h)
+
+    # Exactly 1 unique byte sequence and hash must be produced
+    assert len(canonical_bytes_set) == 1
+    assert len(hash_set) == 1
+    assert b'"timestamp_utc":"2026-10-19T10:00:00Z"' in next(iter(canonical_bytes_set))
+
