+"""
+Comprehensive Tests for Canonical Provenance Event Serialization (Phase 2.1).
+
+Covers all required behaviors:
+1. Equivalent valid events produce byte-identical canonical serialization regardless of key order.
+2. Changes to any meaningful field produce different canonical bytes and SHA-256 hashes.
+3. Unicode NFC normalization guarantees identical bytes for composed vs decomposed forms.
+4. Timestamp parsing, validation, and UTC canonicalization (including microsecond edge cases).
+5. Numeric handling: exact integer preservation, boolean distinction, float finite validation, -0.0 normalization.
+6. Missing vs. null value policy: optional top-level None fields normalized by omission; payload nulls preserved.
+7. Schema version enforcement: strictly accepts "1.0", explicitly rejects unsupported versions.
+8. Invalid events fail explicitly with descriptive exceptions (never silently producing valid output).
+9. Zero mutation of production database.
+"""
+
+from datetime import datetime, timezone
+import hashlib
+import json
+import math
+from pathlib import Path
+import pytest
+
+from provenance.event_serialization import (
+    CURRENT_SCHEMA_VERSION,
+    EventValidationError,
+    ProvenanceEvent,
+    ProvenanceEventError,
+    UnsupportedSchemaVersionError,
+    calculate_event_hash,
+    canonical_serialize_event,
+    canonicalize_event_dict,
+    event_from_dict,
+    normalize_timestamp_utc,
+    validate_event,
+)
+
+
+# ==============================================================================
+# 1. Equivalence & Determinism Tests
+# ==============================================================================
+
+def test_equivalent_events_produce_byte_identical_serialization():
+    """
+    Events with identical semantic data must produce byte-identical canonical
+    bytes and identical hashes regardless of dictionary key insertion order.
+    """
+    event_dict_1 = {
+        "schema_version": "1.0",
+        "event_id": "EVT-001",
+        "event_type": "ASSET_REGISTRATION",
+        "timestamp_utc": "2026-10-19T10:15:30Z",
+        "asset_id": "MP-abc-123",
+        "payload": {
+            "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+            "file_size_bytes": 1048576,
+            "media_type": "video/mp4",
+        },
+    }
+
+    # Different key order at top level and nested in payload
+    event_dict_2 = {
+        "payload": {
+            "media_type": "video/mp4",
+            "file_size_bytes": 1048576,
+            "sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+        },
+        "asset_id": "MP-abc-123",
+        "timestamp_utc": "2026-10-19T10:15:30Z",
+        "event_type": "ASSET_REGISTRATION",
+        "event_id": "EVT-001",
+        "schema_version": "1.0",
+    }
+
+    bytes_1 = canonical_serialize_event(event_dict_1)
+    bytes_2 = canonical_serialize_event(event_dict_2)
+    hash_1 = calculate_event_hash(event_dict_1)
+    hash_2 = calculate_event_hash(event_dict_2)
+
+    assert bytes_1 == bytes_2
+    assert hash_1 == hash_2
+    assert len(hash_1) == 64
+
+    # Dataclass instances from both dicts also produce identical results
+    event_obj_1 = event_from_dict(event_dict_1)
+    event_obj_2 = event_from_dict(event_dict_2)
+    assert event_obj_1.to_canonical_bytes() == bytes_1
+    assert event_obj_2.to_canonical_bytes() == bytes_2
+    assert event_obj_1.calculate_hash() == hash_1
+
+
+def test_repeated_serialization_repeatability():
+    """Serialization must be perfectly repeatable across repeated invocations."""
+    event = ProvenanceEvent(
+        event_id="EVT-REPEAT-001",
+        event_type="MEDIA_VERIFICATION",
