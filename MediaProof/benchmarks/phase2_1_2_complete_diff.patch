+def test_timestamp_date_boundary_and_fractional_precision():
+    """
+    Verifies date-boundary rollover across timezone offsets and fractional
+    second precision canonicalization.
+    """
+    base = {
+        "schema_version": "1.0",
+        "event_id": "EVT-TIME-GATE",
+        "event_type": "ASSET_REGISTRATION",
+        "asset_id": "MP-TIME-GATE",
+        "payload": {},
+    }
+
+    # Date-boundary rollover: 2026-10-19 23:30:00 -01:00 is 2026-10-20 00:30:00 UTC
+    ev_rollover = {**base, "timestamp_utc": "2026-10-19T23:30:00-01:00"}
+    b_rollover = canonical_serialize_event(ev_rollover)
+    assert b'"timestamp_utc":"2026-10-20T00:30:00Z"' in b_rollover
+
+    # Fractional precision equivalence: .5, .50, .500000 all equal 500,000 microseconds
+    b_f1 = canonical_serialize_event({**base, "timestamp_utc": "2026-10-19T10:00:00.5Z"})
+    b_f2 = canonical_serialize_event({**base, "timestamp_utc": "2026-10-19T10:00:00.50Z"})
+    b_f3 = canonical_serialize_event({**base, "timestamp_utc": "2026-10-19T10:00:00.500000Z"})
+    assert b_f1 == b_f2 == b_f3
+    assert b'"timestamp_utc":"2026-10-19T10:00:00.500000Z"' in b_f1
+
+    # Zero fractional seconds: .000000 canonicalizes to no fractional part
+    b_z1 = canonical_serialize_event({**base, "timestamp_utc": "2026-10-19T10:00:00.000000Z"})
+    b_z2 = canonical_serialize_event({**base, "timestamp_utc": "2026-10-19T10:00:00Z"})
+    assert b_z1 == b_z2
+    assert b'"timestamp_utc":"2026-10-19T10:00:00Z"' in b_z1
+
