+def test_unicode_escaping_control_characters_and_surrogate_rejection():
+    """
+    Tests exact JSON character escaping for quotes, backslashes, control
+    characters, and confirms surrogate code points fail predictably with EventValidationError.
+    """
+    base = {
+        "schema_version": "1.0",
+        "event_id": "EVT-ESC",
+        "event_type": "ASSET_REGISTRATION",
+        "timestamp_utc": "2026-10-19T10:00:00Z",
+        "asset_id": "MP-ESC",
+    }
+
+    # Control chars and quotes/backslashes
+    special_text = 'quotes: " backslash: \\ newline: \n tab: \t cr: \r null_byte: \u0000 unit_sep: \u001f'
+    ev_special = {**base, "payload": {"text": special_text}}
+    b_special = canonical_serialize_event(ev_special)
+    raw_str = b_special.decode("utf-8")
+
+    assert r'quotes: \"' in raw_str
+    assert r'backslash: \\' in raw_str
+    assert r'\n' in raw_str
+    assert r'\t' in raw_str
+    assert r'\r' in raw_str
+    assert r'\u0000' in raw_str
+    assert r'\u001f' in raw_str
+
+    # Lone surrogate code points must strictly fail with EventValidationError
+    for surrogate in ["\ud800", "\ud83d", "\udfff"]:
+        bad_payload = {**base, "payload": {"bad_text": f"prefix_{surrogate}_suffix"}}
+        with pytest.raises(EventValidationError, match="surrogate code points"):
+            canonical_serialize_event(bad_payload)
+
+        bad_key = {**base, "payload": {f"key_{surrogate}": "valid_value"}}
+        with pytest.raises(EventValidationError, match="surrogate code points"):
+            canonical_serialize_event(bad_key)
+
